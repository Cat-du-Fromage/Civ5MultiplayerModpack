<Mod id="a08a3228-022a-4681-b1a1-aab5dcccb857" version="13">
  <Properties>
    <Name>JFD's Civilizations - Prussia (Frederick) for Vox Populi</Name>
    <Teaser>[ICON_BULLET]Adds the [COLOR_POSITIVE_TEXT]The Kingdom of Prussia[ENDCOLOR] with Frederick the Great to the game.
			[NEWLINE][ICON_BULLET]Requires at least the [COLOR_POSITIVE_TEXT]3.0[ENDCOLOR] version of Vox Populi.</Teaser>
    <Description>UA- Army with a State
			[NEWLINE]UB1: Kriegsschule (Military Academy)
			[NEWLINE]UU1: Landwehr (Fusilier) 
			[NEWLINE]UB2: Staatseisenbahn (Coaling Station)
			[NEWLINE]UU2: Death's Head Hussar (Cuirassier)</Description>
    <Authors>JFD, Janboruta, HungryForFood, Jarcast</Authors>
    <SpecialThanks>SuperWaffle247, LeeS, Asterix Rage</SpecialThanks>
    <HideSetupGame>0</HideSetupGame>
    <Homepage>https://forums.civfanatics.com/threads/jfds-prussia-for-vp.699330/</Homepage>
    <AffectsSavedGames>1</AffectsSavedGames>
    <MinCompatibleSaveVersion>0</MinCompatibleSaveVersion>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>1</SupportsMultiplayer>
